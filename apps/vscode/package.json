{
  "name": "ognivo",
  "displayName": "ognivo",
  "description": "A coding agent for your own models on llama.cpp's llama-server",
  "version": "0.0.1",
  "publisher": "ognivo",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kristian5013/ognivo"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "llama.cpp",
    "llama-server",
    "local models",
    "agent",
    "gguf"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "ognivo",
          "title": "ognivo",
          "icon": "media/ognivo.svg"
        }
      ]
    },
    "views": {
      "ognivo": [
        {
          "type": "webview",
          "id": "ognivo.chat",
          "name": "Agent",
          "icon": "media/ognivo.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "ognivo.newSession",
        "title": "New Session",
        "category": "ognivo",
        "icon": "$(add)"
      },
      {
        "command": "ognivo.openSession",
        "title": "Open a Session…",
        "category": "ognivo",
        "icon": "$(history)"
      },
      {
        "command": "ognivo.deleteSession",
        "title": "Delete This Session…",
        "category": "ognivo",
        "icon": "$(trash)",
        "enablement": "ognivo.session"
      },
      {
        "command": "ognivo.openInEditor",
        "title": "Open the Agent in an Editor Tab",
        "category": "ognivo",
        "icon": "$(link-external)"
      },
      {
        "command": "ognivo.focus",
        "title": "Focus the Agent",
        "category": "ognivo"
      },
      {
        "command": "ognivo.addSelection",
        "title": "Add the Selection to the Message",
        "category": "ognivo"
      },
      {
        "command": "ognivo.addFile",
        "title": "Add the File to the Message",
        "category": "ognivo"
      },
      {
        "command": "ognivo.chooseModel",
        "title": "Choose the Server and the Model…",
        "category": "ognivo"
      },
      {
        "command": "ognivo.serverKey",
        "title": "Set the Server's API Key…",
        "category": "ognivo"
      },
      {
        "command": "ognivo.settings",
        "title": "Settings, MCP Servers and Instructions",
        "category": "ognivo",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ognivo.mcpServers",
        "title": "MCP Servers",
        "category": "ognivo",
        "icon": "$(plug)"
      },
      {
        "command": "ognivo.instructions",
        "title": "Instructions and the System Prompt",
        "category": "ognivo"
      },
      {
        "command": "ognivo.vscodeSettings",
        "title": "Open VS Code's Settings of ognivo",
        "category": "ognivo"
      },
      {
        "command": "ognivo.showLog",
        "title": "Show the Core's Log",
        "category": "ognivo"
      },
      {
        "command": "ognivo.review",
        "title": "Review the Changes",
        "category": "ognivo",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "ognivo.keepHunk",
        "title": "Keep the Change",
        "category": "ognivo",
        "icon": "$(check)",
        "enablement": "!ognivo.turnRunning"
      },
      {
        "command": "ognivo.undoHunk",
        "title": "Undo the Change",
        "category": "ognivo",
        "icon": "$(discard)",
        "enablement": "!ognivo.turnRunning"
      },
      {
        "command": "ognivo.keepFile",
        "title": "Keep the File's Changes",
        "category": "ognivo",
        "icon": "$(check)",
        "enablement": "!ognivo.turnRunning"
      },
      {
        "command": "ognivo.undoFile",
        "title": "Undo the File's Changes",
        "category": "ognivo",
        "icon": "$(discard)",
        "enablement": "!ognivo.turnRunning"
      },
      {
        "command": "ognivo.nextChange",
        "title": "Go to the Next Change",
        "category": "ognivo",
        "icon": "$(arrow-down)"
      },
      {
        "command": "ognivo.previousChange",
        "title": "Go to the Previous Change",
        "category": "ognivo",
        "icon": "$(arrow-up)"
      },
      {
        "command": "ognivo.diffFile",
        "title": "Show the Diff",
        "category": "ognivo",
        "icon": "$(diff)"
      },
      {
        "command": "ognivo.editSelection",
        "title": "Edit the Selection…",
        "category": "ognivo"
      },
      {
        "command": "ognivo.fixProblem",
        "title": "Fix with ognivo",
        "category": "ognivo"
      },
      {
        "command": "ognivo.showCommands",
        "title": "Show the Agent's Commands",
        "category": "ognivo",
        "icon": "$(terminal)"
      },
      {
        "command": "ognivo.prompt.edit",
        "title": "Edit",
        "category": "ognivo"
      },
      {
        "command": "ognivo.prompt.ask",
        "title": "Ask in the Panel",
        "category": "ognivo"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ognivo.newSession",
          "when": "view == ognivo.chat",
          "group": "navigation@1"
        },
        {
          "command": "ognivo.openSession",
          "when": "view == ognivo.chat",
          "group": "navigation@2"
        },
        {
          "command": "ognivo.openInEditor",
          "when": "view == ognivo.chat",
          "group": "navigation@3"
        },
        {
          "command": "ognivo.mcpServers",
          "when": "view == ognivo.chat",
          "group": "more@0"
        },
        {
          "command": "ognivo.settings",
          "when": "view == ognivo.chat",
          "group": "navigation@4"
        },
        {
          "command": "ognivo.chooseModel",
          "when": "view == ognivo.chat",
          "group": "more@1"
        },
        {
          "command": "ognivo.showLog",
          "when": "view == ognivo.chat",
          "group": "more@2"
        },
        {
          "command": "ognivo.deleteSession",
          "when": "view == ognivo.chat && ognivo.session",
          "group": "session@1"
        },
        {
          "command": "ognivo.review",
          "when": "view == ognivo.chat && ognivo.unreviewed",
          "group": "more@3"
        },
        {
          "command": "ognivo.showCommands",
          "when": "view == ognivo.chat",
          "group": "more@4"
        }
      ],
      "editor/context": [
        {
          "command": "ognivo.editSelection",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "9_ognivo@0"
        },
        {
          "command": "ognivo.addSelection",
          "when": "editorHasSelection",
          "group": "9_ognivo@1"
        },
        {
          "command": "ognivo.addFile",
          "when": "resourceScheme == file",
          "group": "9_ognivo@2"
        }
      ],
      "explorer/context": [
        {
          "command": "ognivo.addFile",
          "when": "!explorerResourceIsFolder",
          "group": "9_ognivo@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "ognivo.addFile",
          "when": "resourceScheme == file",
          "group": "9_ognivo@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ognivo.review",
          "when": "ognivo.unreviewed"
        },
        {
          "command": "ognivo.keepHunk",
          "when": "ognivo.hunkAtCursor"
        },
        {
          "command": "ognivo.undoHunk",
          "when": "ognivo.hunkAtCursor"
        },
        {
          "command": "ognivo.keepFile",
          "when": "resource in ognivo.unreviewedUris"
        },
        {
          "command": "ognivo.undoFile",
          "when": "resource in ognivo.unreviewedUris"
        },
        {
          "command": "ognivo.diffFile",
          "when": "resource in ognivo.unreviewedUris"
        },
        {
          "command": "ognivo.nextChange",
          "when": "ognivo.unreviewed"
        },
        {
          "command": "ognivo.previousChange",
          "when": "ognivo.unreviewed"
        },
        {
          "command": "ognivo.editSelection",
          "when": "editorHasSelection && resourceScheme == file"
        },
        {
          "command": "ognivo.fixProblem",
          "when": "false"
        },
        {
          "command": "ognivo.prompt.edit",
          "when": "false"
        },
        {
          "command": "ognivo.prompt.ask",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "ognivo.previousChange",
          "when": "resource in ognivo.unreviewedUris",
          "group": "navigation@81"
        },
        {
          "command": "ognivo.nextChange",
          "when": "resource in ognivo.unreviewedUris",
          "group": "navigation@82"
        },
        {
          "command": "ognivo.keepFile",
          "when": "resource in ognivo.unreviewedUris",
          "group": "navigation@83"
        },
        {
          "command": "ognivo.undoFile",
          "when": "resource in ognivo.unreviewedUris",
          "group": "navigation@84"
        },
        {
          "command": "ognivo.diffFile",
          "when": "resource in ognivo.unreviewedUris && !isInDiffEditor",
          "group": "navigation@85"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "ognivo.prompt.edit",
          "when": "commentController == ognivo.prompt",
          "group": "inline@1"
        },
        {
          "command": "ognivo.prompt.ask",
          "when": "commentController == ognivo.prompt",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ognivo.focus",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "!editorHasSelection || !editorTextFocus"
      },
      {
        "command": "ognivo.addSelection",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "ognivo.editSelection",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == file"
      },
      {
        "command": "ognivo.keepHunk",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && ognivo.hunkAtCursor"
      },
      {
        "command": "ognivo.undoHunk",
        "key": "ctrl+alt+backspace",
        "mac": "cmd+alt+backspace",
        "when": "editorTextFocus && ognivo.hunkAtCursor"
      },
      {
        "command": "ognivo.nextChange",
        "key": "alt+f5",
        "when": "resource in ognivo.unreviewedUris"
      },
      {
        "command": "ognivo.previousChange",
        "key": "shift+alt+f5",
        "when": "resource in ognivo.unreviewedUris"
      }
    ],
    "configuration": {
      "title": "ognivo",
      "properties": {
        "ognivo.server": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "markdownDescription": "The llama-server a new session works with, or llama-server's router. ognivo never starts one.",
          "order": 1
        },
        "ognivo.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Behind llama-server's router: the model of a new session, by its id. Empty: the one the router runs.",
          "order": 2
        },
        "ognivo.profile": {
          "type": "string",
          "default": "",
          "markdownDescription": "The model's profile (`profiles/*.toml`). Empty: the one that fits the server's model.",
          "order": 3
        },
        "ognivo.reasoning": {
          "type": "string",
          "default": "",
          "markdownDescription": "The reasoning level of a new session (`xhigh`, `medium`, `low`, `off`, as the model has them). Empty: the model's default.",
          "order": 4
        },
        "ognivo.context": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Tokens of working context of a new session. 0: the profile's, within the server's window (`-c`).",
          "order": 5
        },
        "ognivo.mode": {
          "type": "string",
          "enum": [
            "manual",
            "edit_automatically",
            "plan",
            "auto"
          ],
          "enumDescriptions": [
            "Asks before every edit, and before every command that does more than read.",
            "Edits apply at once, to keep or undo in the editor; commands ask as usual.",
            "Reads and plans, and changes nothing: you carry the plan out when it is ready.",
            "Edits and runs commands without asking; protected files, files outside the project and your rules still ask."
          ],
          "default": "edit_automatically",
          "markdownDescription": "The mode a new session starts in. The composer switches it at any time (Shift+Tab).",
          "order": 6
        },
        "ognivo.native": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "The Native path: ognivo renders the model's format itself (gpt-oss, Qwen).",
          "order": 7
        },
        "ognivo.subagents": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "The agent may hand parts of a task to subagents of its own (llama-server `-np 2` or more).",
          "order": 8
        },
        "ognivo.notifications": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "While VS Code is not in front: a notice when a turn of a session on show ends, and when the agent asks.",
          "order": 9
        },
        "ognivo.terminalSuggestions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer the commands that fail in your terminals as context for a message. To do so, ognivo reads what they write, through VS Code's shell integration; it goes to the model only in a message you send.",
          "order": 10
        },
        "ognivo.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The `ognivo` program the core runs as. Empty: the one this extension ships, else `ognivo` on `PATH`.",
          "order": 11
        }
      }
    },
    "colors": [
      {
        "id": "ognivo.unreviewedForeground",
        "description": "The colour of a file the agent changed and nobody reviewed yet, in the explorer and on its tab.",
        "defaults": {
          "light": "#bc4c00",
          "dark": "#f0883e",
          "highContrast": "#f0883e",
          "highContrastLight": "#953800"
        }
      },
      {
        "id": "ognivo.addedLineBackground",
        "description": "The background of the lines the agent added or changed, until they are reviewed.",
        "defaults": {
          "light": "diffEditor.insertedLineBackground",
          "dark": "diffEditor.insertedLineBackground",
          "highContrast": "#2ea04340",
          "highContrastLight": "#2ea04326"
        }
      },
      {
        "id": "ognivo.removedLineMarker",
        "description": "The marker of the place where the agent removed lines, until it is reviewed.",
        "defaults": {
          "light": "editorGutter.deletedBackground",
          "dark": "editorGutter.deletedBackground",
          "highContrast": "editorGutter.deletedBackground",
          "highContrastLight": "editorGutter.deletedBackground"
        }
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "tsc -p tsconfig.json && tsc -p src/webview/tsconfig.json && tsc -p gallery/tsconfig.json && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "package": "node scripts/package.mjs",
    "profiles": "node scripts/profiles.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "e2e": "playwright test",
    "gallery": "node gallery/shoot.mjs"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.45",
    "highlight.js": "11.12.0",
    "markdown-it": "14.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-virtuoso": "4.18.19"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.140.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
