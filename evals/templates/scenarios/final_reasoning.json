{
 "messages": [
  {
   "role": "system",
   "content": "You are a coding agent working in /repo. Keep answers short."
  },
  {
   "role": "user",
   "content": "What is 2+2?"
  },
  {
   "role": "assistant",
   "reasoning_content": "Trivial arithmetic.",
   "content": "4"
  },
  {
   "role": "user",
   "content": "And 3+5?"
  }
 ],
 "tools": [
  {
   "type": "function",
   "function": {
    "name": "read_file",
    "description": "Read a UTF-8 file from the workspace.\nReturns numbered lines.",
    "parameters": {
     "type": "object",
     "properties": {
      "path": {
       "type": "string",
       "description": "Workspace-relative path"
      },
      "start_line": {
       "type": "integer",
       "description": "First line (1-based)"
      },
      "end_line": {
       "type": [
        "integer",
        "null"
       ],
       "description": "Last line or null for EOF"
      }
     },
     "required": [
      "path"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "apply_patch",
    "description": "Apply a patch in the *** Begin Patch format.",
    "parameters": {
     "type": "object",
     "properties": {
      "patch": {
       "type": "string",
       "description": "Patch text"
      },
      "dry_run": {
       "type": "boolean",
       "description": "Only validate",
       "default": false
      }
     },
     "required": [
      "patch"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "run_command",
    "description": "Run a shell command.",
    "parameters": {
     "type": "object",
     "properties": {
      "cmd": {
       "type": "string",
       "description": "Command line"
      },
      "Cwd": {
       "type": "string",
       "description": "Working directory (mixed-case key on purpose)"
      },
      "timeout_s": {
       "type": "integer",
       "description": "Timeout in seconds"
      },
      "env": {
       "type": "object",
       "description": "Extra environment",
       "additionalProperties": {
        "type": "string"
       }
      }
     },
     "required": [
      "cmd"
     ]
    }
   }
  }
 ]
}